{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DisRoute",
  "version": "0.1.0",
  "identifier": "app.disroute.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "DisRoute",
      "width": 1080,
      "height": 780,
      "minWidth": 760,
      "minHeight": 620,
      "resizable": true,
      "center": true
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Discord-only network routing for Windows",
    "longDescription": "Routes Discord TCP and UDP traffic through a user-provided SOCKS5 proxy while leaving other applications direct."
  }
}

