{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DisRoute",
  "version": "0.4.1",
  "identifier": "app.disroute.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "DisRoute",
      "width": 1080,
      "height": 780,
      "minWidth": 760,
      "minHeight": 620,
      "resizable": true,
      "center": true
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["resources/**/*"],
    "category": "Utility",
    "shortDescription": "Discord-only network routing for Windows",
    "longDescription": "Routes Discord TCP and UDP through VLESS, VMess, Trojan, or Shadowsocks. Includes Windows-protected profile storage and a Persian desktop interface.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0QUEyQjZFM0IwOUY5NjAKUldSZytRazdiaXVxWk5yaHRwRDRVZHdQM1JjdVg2OU13YUEzUHJMUG1wQ3l4Tnk0S3JFeWNtK2YK",
      "endpoints": [
        "https://github.com/AlirezaZexter/disroute/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
